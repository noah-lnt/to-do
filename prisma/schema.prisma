generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   Boolean   @default(false)
  password        String
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tasks           Task[]
  categories      Category[]
  tokens          Token[]
  preferences     UserPreferences?
  reminders       Reminder[]
}

model Token {
  id        String    @id @default(cuid())
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([token, type])
  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Recap settings
  dailyRecapEnabled     Boolean  @default(false)
  recapTimes            String[] @default(["08:00", "18:00"])
  recapEmail            Boolean  @default(true)
  // Reminder settings
  defaultReminderMinutes Int     @default(30)
  browserNotifications  Boolean  @default(false)
  emailNotifications    Boolean  @default(true)
  // Display preferences
  timezone              String   @default("Europe/Paris")
  language              String   @default("fr")
  // Saved notification contacts
  savedNotifyEmails     String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Reminder {
  id          String         @id @default(cuid())
  taskId      String
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  remindAt    DateTime
  type        ReminderType   @default(BROWSER)
  sent        Boolean        @default(false)
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([userId, sent])
  @@index([remindAt, sent])
}

enum ReminderType {
  BROWSER
  EMAIL
  BOTH
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  icon      String   @default("folder")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  position    Int        @default(0)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reminders   Reminder[]
  // Recurrence fields
  recurrencePattern  RecurrencePattern?
  recurrenceInterval Int?               @default(1)
  recurrenceEndDate  DateTime?
  parentTaskId       String?
  // Notification fields
  notifyOnComplete   Boolean            @default(false)
  notifyEmail        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@index([userId, categoryId])
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
