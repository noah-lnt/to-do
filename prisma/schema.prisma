generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   Boolean   @default(false)
  password        String
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tasks           Task[]
  categories      Category[]
  tokens          Token[]
  preferences     UserPreferences?
  reminders       Reminder[]
  // Groups
  ownedGroups     Group[]        @relation("GroupOwner")
  groupMemberships GroupMember[]
  assignedTasks   Task[]         @relation("TaskAssignee")
  sentInvitations GroupInvitation[] @relation("InvitationSender")
  receivedInvitations GroupInvitation[] @relation("InvitationRecipient")
}

model Token {
  id        String    @id @default(cuid())
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([token, type])
  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Recap settings
  dailyRecapEnabled     Boolean  @default(false)
  recapTimes            String[] @default(["08:00", "18:00"])
  recapEmail            Boolean  @default(true)
  // Reminder settings
  defaultReminderMinutes Int     @default(30)
  browserNotifications  Boolean  @default(false)
  emailNotifications    Boolean  @default(true)
  // Display preferences
  timezone              String   @default("Europe/Paris")
  language              String   @default("fr")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Reminder {
  id          String         @id @default(cuid())
  taskId      String
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  remindAt    DateTime
  type        ReminderType   @default(BROWSER)
  sent        Boolean        @default(false)
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([userId, sent])
  @@index([remindAt, sent])
}

enum ReminderType {
  BROWSER
  EMAIL
  BOTH
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  icon      String   @default("folder")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  position    Int        @default(0)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reminders   Reminder[]
  // Recurrence
  recurrenceType     RecurrenceType?
  recurrenceInterval Int?            @default(1)
  recurrenceEndDate  DateTime?
  recurrenceDays     Int[]           @default([]) // For weekly: 0=Sun, 1=Mon, etc.
  parentTaskId       String?
  parentTask         Task?           @relation("TaskRecurrence", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks         Task[]          @relation("TaskRecurrence")
  // Group & Assignment
  groupId            String?
  group              Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  assigneeId         String?
  assignee           User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@index([userId, categoryId])
  @@index([groupId])
  @@index([assigneeId])
  @@index([parentTaskId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

// Groups for team collaboration
model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  color       String        @default("#6366f1")
  ownerId     String
  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  tasks       Task[]
  invitations GroupInvitation[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId])
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole       @default(MEMBER)
  joinedAt  DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model GroupInvitation {
  id           String           @id @default(cuid())
  groupId      String
  group        Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email        String
  token        String           @unique @default(cuid())
  status       InvitationStatus @default(PENDING)
  senderId     String
  sender       User             @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String?
  recipient    User?            @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  respondedAt  DateTime?

  @@index([groupId])
  @@index([email])
  @@index([token])
  @@index([recipientId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}
