DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todoapp?schema=public"
NEXTAUTH_SECRET="change-me-in-production-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# SMTP Configuration (pour l'envoi d'emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-password"
SMTP_FROM="TaskFlow <noreply@taskflow.app>"

# Cron secret (pour sécuriser les endpoints cron)
CRON_SECRET="your-cron-secret"

# Docker / PostgreSQL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="todoapp"
APP_DOMAIN="localhost"

# Replication
REPLICATION_USER="replicator"
REPLICATION_PASSWORD="replicator_pass"

# Backups
BACKUP_RETENTION_DAYS="30"

# S3-compatible storage (AWS S3, MinIO, Scaleway, OVH, Backblaze, etc.)
S3_ENABLED="false"
S3_BUCKET="your-bucket-name"
S3_PREFIX="postgres-backups"
S3_ENDPOINT=""
# Pour MinIO local : S3_ENDPOINT="http://minio:9000"
# Pour Scaleway    : S3_ENDPOINT="https://s3.fr-par.scw.cloud"
# Pour OVH         : S3_ENDPOINT="https://s3.gra.io.cloud.ovh.net"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="eu-west-3"
