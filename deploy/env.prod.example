# =============================================
# Production Server (.env)
# =============================================
# Traefik is external and shared between apps

# Application
APP_DOMAIN="todo.example.com"
NEXTAUTH_SECRET="CHANGER-MOI-32-chars-minimum-alea"
NEXTAUTH_URL="https://todo.example.com"

# PostgreSQL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGER-MOI-mot-de-passe-fort"
POSTGRES_DB="todoapp"

# SMTP (emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASSWORD="CHANGER-MOI"
SMTP_FROM="TaskFlow <noreply@example.com>"

# Cron (for reminders and daily recaps)
CRON_SECRET="CHANGER-MOI-secret-cron"

# Backups
BACKUP_RETENTION_DAYS="30"

# Option A : Synology NAS (rsync/SSH) — RECOMMENDED
RSYNC_ENABLED="true"
RSYNC_TARGET="admin@192.168.1.50:/volume1/backups/taskflow"
SSH_KEY_PATH="/root/.ssh/id_ed25519"

# Option B : S3-compatible (AWS, MinIO, Scaleway, OVH)
S3_ENABLED="false"
S3_BUCKET=""
S3_PREFIX="postgres-backups"
S3_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="eu-west-3"
